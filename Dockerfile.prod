# Etapa de construcción
FROM node:18-alpine AS builder

# Declarar variables de construcción desde Cloud Build
# Permite que --build-arg GOOGLE_MAPS_API_KEY y --build-arg DATABASE_URL se expandan
ARG GOOGLE_MAPS_API_KEY
ARG DATABASE_URL

WORKDIR /app

# Instalar pnpm
RUN npm install -g pnpm

# Copiar archivos de dependencias
COPY integra-rh-manus/package.json integra-rh-manus/pnpm-lock.yaml ./integra-rh-manus/

# Copiar carpeta de patches si existe (necesaria para pnpm install)
COPY integra-rh-manus/patches ./integra-rh-manus/patches

# Instalar dependencias
WORKDIR /app/integra-rh-manus
RUN pnpm install --frozen-lockfile

# Copiar código fuente
WORKDIR /app
COPY integra-rh-manus ./integra-rh-manus

# Exportar variables de Firebase para que Vite las compile en el bundle
# FIX REFERENCE: FIX-20260310-01
# Las variables ARG están disponibles porque se declararon al inicio del Dockerfile
WORKDIR /app/integra-rh-manus

# Crear .env.production con valores de ARGs
RUN echo "VITE_GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}" > .env.production && \
    echo "DEBUG: VITE_GOOGLE_MAPS_API_KEY=$(cat .env.production)" && \
    cat .env.production

# BUILD
RUN npm run build

# Etapa de producción
FROM node:18-alpine

WORKDIR /app

# Copiar archivos necesarios desde la etapa de construcción
COPY --from=builder /app/integra-rh-manus/dist ./dist
COPY --from=builder /app/integra-rh-manus/package.json ./

# Instalar solo dependencias de producción
RUN npm install --omit=dev --legacy-peer-deps

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["node", "dist/index.js"]
