# Etapa de construcción
FROM node:18-alpine AS builder

# Declarar variables de construcción desde Cloud Build
# Permite que --build-arg GOOGLE_MAPS_API_KEY y --build-arg DATABASE_URL se expandan
ARG GOOGLE_MAPS_API_KEY
ARG DATABASE_URL

WORKDIR /app

# Instalar pnpm
RUN npm install -g pnpm

# Copiar archivos de dependencias
COPY integra-rh-manus/package.json integra-rh-manus/pnpm-lock.yaml ./integra-rh-manus/

# Copiar carpeta de patches si existe (necesaria para pnpm install)
COPY integra-rh-manus/patches ./integra-rh-manus/patches

# Instalar dependencias
WORKDIR /app/integra-rh-manus
RUN pnpm install --frozen-lockfile

# Copiar código fuente
WORKDIR /app
COPY integra-rh-manus ./integra-rh-manus

# Exportar variables de Firebase para que Vite las compile en el bundle
# FIX REFERENCE: FIX-20260310-01
# Las variables ARG están disponibles porque se declararon al inicio del Dockerfile
WORKDIR /app/integra-rh-manus

# Solo sobreescribir GOOGLE_MAPS_API_KEY si el build arg tiene valor (evitar borrar el existente en .env.production)
RUN if [ -n "${GOOGLE_MAPS_API_KEY}" ]; then \
      echo "VITE_GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}" >> .env.production; \
    fi && \
    echo "DEBUG: .env.production content:" && \
    cat .env.production

# BUILD
RUN npm run build

# Etapa de producción
FROM node:18-alpine

WORKDIR /app

# Instalar Chromium del sistema + dependencias gráficas necesarias para headless PDF
# @intervention IMPL-20260408-03 | Chromium Alpine para HTML-first PDF renderer
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont

# Ruta del Chromium del sistema para playwright-core (no descarga binario propio)
ENV CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Instalar pnpm para reproducir el lockfile exacto en producción
# @intervention IMPL-20260408-14
RUN npm install -g pnpm

# Copiar artefactos de build y manifiestos de dependencias
COPY --from=builder /app/integra-rh-manus/dist ./dist
COPY --from=builder /app/integra-rh-manus/package.json ./
COPY --from=builder /app/integra-rh-manus/pnpm-lock.yaml ./
COPY --from=builder /app/integra-rh-manus/patches ./patches

# Instalar solo dependencias de producción con versiones exactas del lockfile
# Garantiza que playwright-core se instale correctamente para el renderer HTML-first
RUN pnpm install --prod --frozen-lockfile

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["node", "dist/index.js"]
